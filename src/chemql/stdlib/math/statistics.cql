
[import statistics as _chemql_statistics]
public func mean
    return _chemql_statistics.mean(arguments)
endfunc
public func median
    return _chemql_statistics.median(arguments)
endfunc
public func median_low
    return _chemql_statistics.median_low(arguments)
endfunc
public func median_high
    return _chemql_statistics.median_high(arguments)
endfunc
public func mode
    return _chemql_statistics.mode(arguments)
endfunc
public func multimode
    return _chemql_statistics.multimode(arguments)
endfunc
public func variance
    return _chemql_statistics.variance(arguments)
endfunc
public func stdev
    return _chemql_statistics.stdev(arguments)
endfunc
public func pvariance
    return _chemql_statistics.pvariance(arguments)
endfunc
public func pstdev
    return _chemql_statistics.pstdev(arguments)
endfunc
public func harmonic_mean
    return _chemql_statistics.harmonic_mean(arguments)
endfunc
public func geometric_mean
    return _chemql_statistics.geometric_mean(arguments)
endfunc
public func quantiles
    return _chemql_statistics.quantiles(arguments, n=4)
endfunc
